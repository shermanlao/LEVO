{
  "name": "levo-backend",
  "version": "1.0.0",
  "description": "Backend API for LEVO website",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "seed": "ts-node src/seed.ts",
    "db:copy-sqlite-to-pg": "ts-node src/scripts/copySqliteToPostgres.ts",
    "test": "node -r ts-node/register/transpile-only --test src/lib/shared/*.test.ts src/lib/ssrf.test.ts"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^8.3.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.20.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.33.0",
    "sharp": "^0.34.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
