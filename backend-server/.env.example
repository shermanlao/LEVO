# Leave DATABASE_URL unset for local SQLite (backend-server/database.sqlite).
# Production / PostgreSQL:
# DATABASE_URL=postgres://levo:password@127.0.0.1:5432/levo
# DB_DIALECT=postgres
# DATABASE_SSL=true
# DATABASE_SSL_INSECURE=true

# Optional SQLite path override
# SQLITE_PATH=C:\path\to\database.sqlite

# First-boot admin (used only when admin_users is empty)
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@levo.local
# ADMIN_PASSWORD=change-me
# ADMIN_SESSION_SECRET=change-me-long-random
# AI_SETTINGS_ENCRYPTION_KEY=change-me-long-random
# INTERNAL_API_SECRET=change-me-long-random

PORT=3333
SITE_ORIGIN=http://localhost:3000
